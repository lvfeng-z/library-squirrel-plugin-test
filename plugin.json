{
  "id": "com.lvfeng.test-plugin",
  "name": "测试插件",
  "version": "1.1.0",
  "contractVersion": 13,
  "author": "lvfeng",
  "description": "最小测试插件——验证前端扩展点（resourceViewer Handler 等），仅供开发测试，发布前应移除",
  "entryFile": "test_plugin.exe",
  "activation": { "type": 1 },
  "settings": [
    {
      "key": "enableParticipation",
      "type": "boolean",
      "title": "参与派生面",
      "description": "关闭后：专栏渲染器（resourceViewer）与作品拉取候选（含 URL 监听）立即退出，重新打开立即恢复——验证设置驱动的派生面热生效",
      "default": "true"
    }
  ],
  "settingsResolver": { "script": "resolver.js", "contractVersion": 1 },
  "extensions": {
    "workFetch": [
      {
        "id": "main",
        "name": "测试作品拉取（只声明与应答）",
        "description": "测试作品拉取（只声明与应答，不做真实抓取）",
        "siteKey": "bilibili",
        "urlPatterns": [
          "^https?://www\\.bilibili\\.com/video/(BV[a-zA-Z0-9]+|av\\d+)",
          "^https?://b23\\.tv/[A-Za-z0-9]+",
          "^https?://www\\.bilibili\\.com/(opus|dynamic)/\\d+",
          "^https?://www\\.bilibili\\.com/read/cv\\d+"
        ]
      }
    ],
    "siteAuthorFetch": [
      { "id": "main", "name": "主作者源", "sites": ["bilibili"] },
      { "id": "alt", "name": "备用作者源", "sites": ["bilibili"] }
    ],
    "frontendExtensions": [
      {
        "id": "test-article-viewer",
        "name": "测试·专栏渲染器",
        "description": "覆盖 article 内置渲染器，验证 resourceViewer Handler 通道（插件渲染器命中时替换内置 ArticleRenderer）",
        "kind": "resourceViewer",
        "content": {
          "contentType": "precompiled",
          "source": { "js": "views/article-viewer.js", "css": "views/article-viewer.css" },
          "resourceType": "article"
        }
      },
      {
        "id": "test-preference-drill",
        "name": "测试·偏好演练",
        "description": "偏好域三方法演练页：经 SDK GetPreference/SetPreference/ListMyPreferences 写入、覆写、读取、列键，结果经前后端事件通道回发展示",
        "kind": "view",
        "content": {
          "contentType": "precompiled",
          "source": { "js": "views/preference-drill.js", "css": "views/preference-drill.css" }
        }
      },
      {
        "id": "test-preference-menu",
        "name": "偏好演练",
        "description": "侧栏菜单入口，跳转偏好演练页",
        "kind": "menu",
        "content": { "viewId": "test-preference-drill" }
      }
    ]
  }
}
